{
  "stellar": {
    "version": "2.0.0"
  },
  "appearance": {
    "preset": "card",
    "color_scheme": "dark",
    "colors": {
      "primary": "hsl(192 98% 55%)",
      "accent": "hsl(14 100% 57%)",
      "link": "hsl(207 90% 54%)"
    },
    "gradients": {
      "primary_action": "linear-gradient(to right, hsl(215, 95%, 64%), hsl(195, 95%, 60%), hsl(165, 95%, 56%), hsl(165, 95%, 56%), hsl(195 95% 60%), hsl(215, 95%, 64%))",
      "search_bar": "linear-gradient(to right, #04f3ff, #08ffc6, #ddf730, #ffbd19, #ff1fe0, #c418ff, #3b5bff, #04f3ff)"
    },
    "typography": {
      "font_smoothing": "antialiased",
      "font_weight": {
        "100": 100,
        "200": 200,
        "300": 300,
        "400": 400,
        "500": 500,
        "600": 600,
        "700": 700,
        "800": 800,
        "900": 900
      },
      "font_family": {
        "body": "\"LXGW WenKai Screen\", system-ui, \"Microsoft Yahei\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "code": "\"LXGW WenKai Screen\", Menlo, Monaco, Consolas, system-ui, \"Courier New\", monospace, sans-serif"
      },
      "font_size": {
        "root": "16px",
        "inline_code": "85%",
        "code_block": "0.8125rem"
      },
      "content_align": "left"
    },
    "shape": {
      "corner": "superellipse(1.25)",
      "radius": {
        "card_large": "24px",
        "card": "16px",
        "card_small": "12px",
        "bar": "12px",
        "image_large": "24px",
        "image": "16px",
        "image_small": "8px"
      }
    },
    "backgrounds": {
      "page": {
        "image": "",
        "backdrop": {
          "radius": "100px",
          "overlay": "var(--bg-a75)",
          "saturation": "300%"
        }
      }
    },
    "code_block": {
      "scrollbar_width": "4px",
      "highlight_stylesheet": "https://gcore.jsdelivr.net/gh/highlightjs/cdn-release@11.9/build/styles/atom-one-dark.min.css"
    }
  },
  "article": {
    "style": "tech",
    "listing": {
      "pinned_layout": "carousel",
      "card_layout": "hero",
      "cover_ratio": 2,
      "excerpt_length": 128,
      "show_tags": false
    },
    "show_reading_time": false
  },
  "tags": {
    "checkbox": {
      "interactive": false
    },
    "note": {
      "border": true
    }
  },
  "features": {
    "color_scheme_switch": {
      "enabled": false
    },
    "lazy_loading": {
      "transition": "none"
    },
    "card_hover": {
      "spotlight": true,
      "tilt": true
    },
    "math": {
      "provider": null
    }
  },
  "local": {
    "code_block_font_family": "Menlo, Monaco, Consolas, system-ui, monospace, sans-serif",
    "loading": {
      "loading": "正在加载",
      "error": "加载失败，请稍后重试。"
    }
  }
}
