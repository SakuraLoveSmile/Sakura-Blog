// 本地排版与文案兼容；上游 2.0 不再提供独立代码块字体或构建期加载文案。
:root
  --text-loading: hexo-config('local.loading.loading')
  --text-loading-error: hexo-config('local.loading.error')

pre,
pre > code,
.md-text .highlight,
.md-text .gist .blob-code-inner
  font-family: convert(hexo-config('local.code_block_font_family'))

// 已保存的图库和动态专辑仍使用 1.x ratio 属性；与 2.0 aspect_ratio 等效。
.tag-plugin.gallery.grid-box
  &[ratio='square'] .grid-cell
    aspect-ratio: 1
  &[ratio='portrait'] .grid-cell
    aspect-ratio: 2 / 3

// 上游 2.0 移除了 about，但本地内容渲染仍支持；保留 1.44 的结构与布局。
.tag-plugin.about
  background: var(--block)
  border-radius: convert(hexo-config('appearance.shape.radius.card'))
  padding: 2rem
  position: relative
  .nav-back
    display: none
    position: absolute
    line-height: 1
    overflow: hidden
    left: 0.75rem
    top: 0.75rem
    align-items: center
    @media screen and (max-width: 667px)
      display: flex
    svg
      width: 1rem
      height: 1rem
  .about-header
    display: flex
    justify-content: center
    flex-wrap: wrap
    margin: 1.5rem 0
    img
      object-fit: contain
    >img
      margin: auto 0
    >p
      font-size: calc(var(--fs-content-base) - 4px)
      font-weight: 500
      color: var(--text-p3)
      padding-top: 0.75rem
      strong:first-child
        font-size: 3rem
        font-weight: 700
        color: var(--text-p1)
        margin-right: 0.75rem
    .avatar
      display: inline-flex
      margin: 0 1rem
  .about-body
    >p
      line-height: 1.5
      &:first-child
        margin-top: 2.5rem
    p+.tag-plugin.navbar .cap
      margin-top: 1rem
  .about-header+.about-body
    margin-top: 2rem

@media screen and (max-width: 500px)
  .tag-plugin.about
    padding: 2rem 1rem
    .about-header p
      width: 100%

// 旧 dropdown 图标包装器没有 ui-icon；限定其尺寸，不影响新版包装器。
.dropdown-menu .ui-collection__leading:not(.ui-icon)
  display: inline-flex
  flex: 0 0 1.5rem
  width: 1.5rem
  height: 1.5rem
  align-items: center
  justify-content: center
  >svg
    width: 100%
    height: 100%

// 只给 SVG 根节点的缺省 fill 着色；子节点显式 fill（含彩色/none）继续继承原值。
.dropdown-menu .ui-collection__leading > svg:not([fill]),
.search-trigger .ui-icon > svg:not([fill])
  fill: currentColor

// 新搜索框嵌在 dialog header 中，原 .search-wrapper > .search-form 不再匹配。
.search-dialog__header .search-form
  position: relative
  &:after
    position: absolute
    content: ''
    height: 2px
    bottom: 0
    left: 1rem
    right: 1rem
    border-radius: convert(hexo-config('appearance.shape.radius.bar'))
    background: convert(hexo-config('appearance.gradients.search_bar'))
    background-size: 200%
    animation: search-glow 20s linear infinite
    opacity: 0
    pointer-events: none
    z-index: 1
    transition: opacity 0.3s
  &:hover:after,
  &:has(input:focus):after,
  &:has(input:not(:placeholder-shown)):after
    opacity: 1

// 已保存的 radio 内容没有 2.0 ui-radio 类；保留 16px 圆环、主题色与禁用交互。
.md-text .tag-plugin.checkbox input[type='radio']
  -webkit-appearance: none
  -moz-appearance: none
  appearance: none
  box-sizing: border-box
  display: inline-block
  flex: 0 0 auto
  width: 16px
  height: 16px
  border: 0
  border-radius: 50%
  corner-shape: round
  --radio-ring: var(--theme)
  --radio-dot-size: 0
  background-image: radial-gradient(circle closest-side, transparent 0 5.875px, var(--radio-ring) 6.125px 100%), radial-gradient(circle closest-side, var(--theme) 0 3.875px, transparent 4.125px)
  background-position: center, center
  background-repeat: no-repeat, no-repeat
  background-size: 16px 16px, var(--radio-dot-size) var(--radio-dot-size)
  cursor: pointer
  &:checked
    --radio-dot-size: 8px
  &:focus-visible
    outline: 2px solid var(--theme)
    outline-offset: 2px
