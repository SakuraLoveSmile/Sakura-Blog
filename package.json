{
  "name": "blog-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "lint": "eslint \"modules/console/web/src/**/*.{ts,vue}\" \"packages/**/*.{ts,vue}\" --max-warnings=0",
    "format": "prettier --write \"modules/console/web/src/**/*.{ts,vue,css}\" \"packages/**/*.{ts,vue,ts}\"",
    "format:check": "prettier --check \"modules/console/web/src/**/*.{ts,vue,css}\" \"packages/**/*.{ts,vue,ts}\"",
    "packages:build": "pnpm --filter @blog/plugin-runtime run build",
    "packages:publish:dry": "pnpm --filter @blog/plugin-runtime publish --dry-run --no-git-checks",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.0.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.67.0",
    "vue-eslint-parser": "10.4.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tiptap/core@2.27.2": "patches/@tiptap__core@2.27.2.patch"
    }
  }
}
