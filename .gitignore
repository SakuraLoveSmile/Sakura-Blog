# 参考资源（Stellar 主题克隆，不入版本控制）
resource/

# Spec 文档与基线图（并行开发归档，不入版本控制）
specs/

# 系统文件
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# 数据库
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# 编辑器
.vscode/
.idea/

# AI 工具本地产物（harness 报告等），不入库
.qoder/
# AI 工具运行时索引产物（向量索引 / 搜索缓存 / 知识图谱），可再生，不入库
.workflow/
*.swp
*.swo

# 设计稿/原型（admin-console 原型等），不入版本控制
admin-console-prototype/

# 构建产物
dist/
tmp/
.tmp/
.cache/
/server
/blog
# go build ./cmd/blog 会在 cmd/blog/ 下生成同名二进制（曾误入库，68MB）
backend/server
# go build ./cmd/... 会在包目录下生成同名二进制
/cmd/blog

# CI 交叉编译产物（release.yml 在 Actions 内构建，本地不应提交）
blog-linux-amd64
blog-linux-amd64.sha256

# 运行时数据
data/
blog-data/

# 本地配置（含密钥：GitHub PAT / admin 密码 / SMTP 密码），不入库。
# 版本控制仅跟踪 *.example.yml 模板；首次部署复制 example 为正式文件再填值。
backend/config/app.yml
backend/config/site.yml
