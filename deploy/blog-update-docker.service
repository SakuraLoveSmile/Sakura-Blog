[Unit]
Description=Blog manual update executor (docker driver)
# 手动触发：sudo systemctl start blog-update-docker（等价 sudo update-docker.sh）。
# 与 update.sh 不同在于通过 docker restart 重启服务。

[Service]
Type=oneshot
ExecStart=/opt/blog/update-docker.sh
# 部署差异参数集中在这里覆盖：容器名 / 健康检查端口 / GitHub 代理等。
# 例：BLOG_CONTAINER=blog  BLOG_HEALTH_PORT=8081  BLOG_PROXY=http://127.0.0.1:7890
EnvironmentFile=-/opt/blog/update-docker.env

[Install]
WantedBy=multi-user.target
