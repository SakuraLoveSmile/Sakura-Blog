# 定时检查更新（每 6 小时）
# 安装：cp blog-update.timer blog-update.service /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now blog-update.timer

[Unit]
Description=Stellar Blog auto-update check

[Timer]
OnCalendar=*-*-* 03,09,15,21:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
