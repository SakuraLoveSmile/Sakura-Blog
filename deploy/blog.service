# 博客服务 systemd 单元
# 安装：cp blog.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now blog

[Unit]
Description=Stellar Blog (Go SSR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/opt/blog
ExecStart=/opt/blog/blog
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# 环境变量（按需修改）
Environment=BLOG_LISTEN=:8080
Environment=BLOG_DB=/opt/blog/data/blog.db
Environment=BLOG_ROOT=/opt/blog
Environment=BLOG_AUTO_BACKUP=true
Environment=BLOG_BACKUP_KEEP=7
Environment=TZ=Asia/Shanghai
Environment=GIN_MODE=release
# GitHub Token 通过 /etc/systemd/system/blog.service.d/10-secrets.conf 注入，禁止写入本 unit。

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/blog/data /opt/blog/update/requests
PrivateTmp=true

[Install]
WantedBy=multi-user.target
